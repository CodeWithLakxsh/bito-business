# ============================================================
# Bito Business — Environment Configuration Reference
# ============================================================
#
# IMPORTANT: This file is DOCUMENTATION ONLY.
# It is NOT automatically loaded by Flutter. This project has no
# runtime environment-file loader (no flutter_dotenv, no .env
# package). The values below are supplied at COMPILE TIME and are
# referenced from the source files listed under "Sourced from".
#
# Never put real credentials here. Copy nothing from this file
# into a real deployment without substituting safe real values
# through the documented mechanism.
#
# ============================================================
# Compile-time configuration (--dart-define)
# ============================================================
#
# ADMIN_TOTP_SECRET
#   Base32 shared secret used by the client-side TOTP gate
#   (lib/auth_screen.dart).
#   Supply at build/run time:
#     flutter run  --dart-define=ADMIN_TOTP_SECRET=<value>
#     flutter build web --release --dart-define=ADMIN_TOTP_SECRET=<value>
#   SECURITY WARNING: client-side TOTP is a CRITICAL SECURITY
#   ARCHITECTURE ISSUE. Any secret compiled into a Flutter client
#   can be extracted. Prefer server-side authentication.
#   Default (placeholder, non-functional): YOUR_TOTP_SECRET
ADMIN_TOTP_SECRET=YOUR_TOTP_SECRET

# ============================================================
# Firebase configuration (lib/firebase_options.dart)
# ============================================================
# Firebase client options are compile-time constants in
# lib/firebase_options.dart, generated by the FlutterFire CLI:
#     flutterfire configure
# The file currently ships with YOUR_* placeholders and must be
# regenerated against the real Firebase project before use.
#
# FIREBASE_API_KEY=YOUR_API_KEY
# FIREBASE_APP_ID=YOUR_APP_ID
# FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
# FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
# FIREBASE_AUTH_DOMAIN=YOUR_AUTH_DOMAIN
# FIREBASE_STORAGE_BUCKET=YOUR_STORAGE_BUCKET
# FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID
#
# Android additionally requires android/app/google-services.json
# (see android/app/google-services.json.example). Generate it with
# `flutterfire configure` or download it from the Firebase console.

# ============================================================
# Telegram alerts (lib/telegram_service.dart)
# ============================================================
# Constants in lib/telegram_service.dart. Currently placeholders.
# TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
# TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# ============================================================
# Push notification endpoint (lib/notification_sender_screen.dart)
# ============================================================
# Cloud Run HTTP endpoint invoked to fan out push notifications.
# PUSH_NOTIFICATION_URL=https://YOUR-CLOUD-RUN-SERVICE-URL.run.app
