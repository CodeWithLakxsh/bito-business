# ============================================================
# Bito Business — .gitignore
# ============================================================

# ---------- Miscellaneous ----------
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# ---------- IntelliJ / IDE ----------
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# ---------- Environment / Secrets ----------
# Never commit real credentials or local environment files.
.env
.env.*
!.env.example
**/google-services.json
**/GoogleService-Info.plist
key.properties
**/*.keystore
**/*.jks

# ---------- Flutter/Dart/Pub ----------
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.flutter-plugins-dependencies*
.pub-cache/
.pub/
/build/
/coverage/

# ---------- Generated platform files (never commit) ----------
# iOS
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/ephemeral/
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/app.flx
ios/Flutter/app.zip
ios/Flutter/flutter_assets/
ios/Flutter/.last_build_id
ios/Runner/GeneratedPluginRegistrant.*

# macOS
macos/Flutter/ephemeral/
macos/Flutter/GeneratedPluginRegistrant.swift

# Windows / Linux ephemeral plugin symlinks
windows/flutter/ephemeral/
linux/flutter/ephemeral/

# Duplicate generated copies created by some editors/sync tools
*. 2.*
*. 3.*
*. 4.*
**/flutter_export_environment*.sh
**/Generated*.xcconfig
**/.plugin_symlinks*/

# ---------- Symbolication ----------
app.*.symbols

# ---------- Obfuscation ----------
app.*.map.json

# ---------- Android Studio build artifacts ----------
/android/app/debug
/android/app/profile
/android/app/release
/android/.gradle/
/android/.kotlin/
/android/local.properties
